{
  "dashboard": {
    "id": null,
    "uid": "bolt-metrics",
    "title": "Bolt Container Runtime - Performance Metrics",
    "tags": ["bolt", "containers", "gpu", "performance"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "type": "graph",
        "title": "Container CPU Usage",
        "targets": [
          {
            "expr": "rate(bolt_container_cpu_usage_seconds_total[1m])",
            "legendFormat": "{{container_id}} - {{container_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "percent", "label": "CPU %", "show": true },
          { "format": "short", "show": false }
        ],
        "xaxis": { "show": true, "mode": "time" },
        "legend": { "show": true, "values": true, "current": true, "max": true }
      },
      {
        "id": 2,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "type": "graph",
        "title": "Container Memory Usage",
        "targets": [
          {
            "expr": "bolt_container_memory_usage_bytes / 1024 / 1024",
            "legendFormat": "{{container_id}} - {{container_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "decmbytes", "label": "Memory", "show": true },
          { "format": "short", "show": false }
        ],
        "xaxis": { "show": true, "mode": "time" },
        "legend": { "show": true, "values": true, "current": true, "max": true }
      },
      {
        "id": 3,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "type": "graph",
        "title": "GPU Utilization",
        "targets": [
          {
            "expr": "bolt_gpu_utilization_percent",
            "legendFormat": "GPU {{gpu_index}} - {{gpu_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "percent", "label": "GPU %", "show": true, "min": 0, "max": 100 },
          { "format": "short", "show": false }
        ],
        "xaxis": { "show": true, "mode": "time" },
        "legend": { "show": true, "values": true, "current": true, "avg": true, "max": true }
      },
      {
        "id": 4,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "type": "graph",
        "title": "GPU Memory Usage",
        "targets": [
          {
            "expr": "bolt_gpu_memory_used_bytes / 1024 / 1024 / 1024",
            "legendFormat": "GPU {{gpu_index}} Used",
            "refId": "A"
          },
          {
            "expr": "bolt_gpu_memory_total_bytes / 1024 / 1024 / 1024",
            "legendFormat": "GPU {{gpu_index}} Total",
            "refId": "B"
          }
        ],
        "yaxes": [
          { "format": "decgbytes", "label": "VRAM", "show": true },
          { "format": "short", "show": false }
        ],
        "xaxis": { "show": true, "mode": "time" },
        "legend": { "show": true, "values": true, "current": true }
      },
      {
        "id": 5,
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
        "type": "stat",
        "title": "Total Containers",
        "targets": [
          {
            "expr": "bolt_containers_running_total",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
        "type": "stat",
        "title": "Network Throughput (RX)",
        "targets": [
          {
            "expr": "rate(bolt_network_rx_bytes_total[1m]) / 1024 / 1024",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "MBs",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 100 },
                { "color": "red", "value": 500 }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
        "type": "stat",
        "title": "Network Throughput (TX)",
        "targets": [
          {
            "expr": "rate(bolt_network_tx_bytes_total[1m]) / 1024 / 1024",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "MBs",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 100 },
                { "color": "red", "value": 500 }
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
        "type": "graph",
        "title": "QUIC Networking Latency",
        "targets": [
          {
            "expr": "bolt_quic_latency_microseconds",
            "legendFormat": "{{connection_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "µs", "label": "Latency", "show": true },
          { "format": "short", "show": false }
        ],
        "xaxis": { "show": true, "mode": "time" },
        "legend": { "show": true, "values": true, "current": true, "avg": true, "min": true }
      }
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "annotations": {
      "list": [
        {
          "datasource": "Bolt Prometheus",
          "enable": true,
          "expr": "bolt_container_started_total",
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Container Events",
          "step": "60s",
          "tagKeys": "container_name",
          "textFormat": "Container started: {{container_name}}",
          "titleFormat": "Container Event"
        }
      ]
    }
  },
  "overwrite": true
}
